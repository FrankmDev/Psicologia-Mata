# Google Search Console HTML tag verification content value
PUBLIC_GSC_VERIFICATION=

# Contact form SMTP configuration (server-only; never expose these values with PUBLIC_)
SMTP_HOST=smtp.dondominio.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# CONTACT_FROM must be an address/name accepted by the SMTP account.
# CONTACT_TO is the real recipient of form messages.
# Set CONTACT_TO to the same public contact shown on the website when that is intended.
CONTACT_FROM=
CONTACT_TO=
