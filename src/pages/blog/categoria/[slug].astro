---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Schema from '../../../components/Schema.astro';
import {
  getBlogCategories,
  getCategoryBySlug,
  getPostsByCategory,
  categoryToSlug,
} from '../../../data/blog';
import { SITE_URL } from '../../../config/site';

export function getStaticPaths() {
  return getBlogCategories().map((category) => ({
    params: { slug: categoryToSlug(category) },
  }));
}

const { slug } = Astro.params;
const category = getCategoryBySlug(slug as string);

if (!category) {
  return Astro.redirect('/404');
}

const posts = getPostsByCategory(category);
const SITE = SITE_URL;
const canonicalPath = `/blog/categoria/${slug}/`;

const title = `${category} | Blog de psicología en Córdoba`;
const description = `Artículos de psicología sobre ${category.toLowerCase()} por María Ángeles Mata, psicóloga en Córdoba y online.`;
const keywords = `blog psicología ${category.toLowerCase()}, psicóloga córdoba, ${category.toLowerCase()}`;

const breadcrumbData = [
  { name: 'Inicio', url: `${SITE}/` },
  { name: 'Blog', url: `${SITE}/blog/` },
  { name: category, url: `${SITE}${canonicalPath}` },
];
---

<Layout {title} {description} {keywords} canonical={canonicalPath}>
  <Schema slot="schema" type="breadcrumbs" data={breadcrumbData} />
  <Schema
    slot="schema"
    type="webpage"
    data={{ name: title, description, url: `${SITE}${canonicalPath}` }}
  />
  <Header activePage="Blog" />

  <main id="main-content">
    <section class="section bg-alabaster relative overflow-hidden" aria-labelledby="category-heading">
      <div class="bg-aurora"></div>

      <div class="container-editorial relative z-10">
        <PageHeader
          label="Blog"
          title={category}
          description={`Artículos sobre ${category.toLowerCase()} escritos desde la consulta de psicología en Córdoba y pensados también para quien busca apoyo online.`}
        />
      </div>
    </section>

    <section class="section bg-cream relative">
      <div class="container-editorial">
        <div class="border-t border-border-strong/30">
          {posts.map((post, index) => (
            <article
              class="group border-b border-border-strong/30 hover:bg-cream/50 transition-colors duration-500"
              data-reveal
              data-reveal-delay={index * 100}
            >
              <a href={`/blog/${post.slug}/`} class="block py-10 lg:py-12">
                <div class="flex flex-col lg:flex-row lg:items-center gap-4 lg:gap-12">
                  <div class="w-full lg:w-24 shrink-0 flex items-center gap-4 lg:gap-0">
                    <span class="text-label text-olive w-8">0{index + 1}</span>
                  </div>

                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-4 mb-3">
                      <span class="text-label-xs text-charcoal uppercase tracking-[0.15em]">{post.category}</span>
                      <span class="w-8 h-[1px] bg-border-delicate"></span>
                      <span class="text-label-xs text-charcoal/70">{post.date}</span>
                    </div>

                    <h2
                      id={index === 0 ? 'category-heading' : undefined}
                      class="font-serif text-xl lg:text-2xl text-ink group-hover:text-olive transition-colors duration-500 leading-tight mb-3"
                    >
                      {post.title}
                    </h2>

                    <p class="text-body-sm text-charcoal line-clamp-2 max-w-2xl">{post.excerpt}</p>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
