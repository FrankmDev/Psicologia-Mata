---
import '../../../styles/article.css';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CTASection from '../../../components/CTASection.astro';
import Schema from '../../../components/Schema.astro';
import { Image } from 'astro:assets';
import {
  getBlogCategories,
  getCategoryBySlug,
  getPostsByCategory,
  getCategorySeo,
  getCategoryUrl,
  categoryToSlug,
} from '../../../data/blog';
import { SITE_URL } from '../../../config/site';

export function getStaticPaths() {
  return getBlogCategories().map((category) => ({
    params: { slug: categoryToSlug(category) },
  }));
}

const { slug } = Astro.params;
const category = getCategoryBySlug(slug as string);

if (!category) {
  return Astro.redirect('/404');
}

const posts = getPostsByCategory(category);
const categorySeo = getCategorySeo(category);
const canonicalPath = `/blog/categoria/${slug}/`;
const canonicalUrl = `${SITE_URL}${canonicalPath}`;

const title = categorySeo.title;
const description = categorySeo.description;
const keywords = `blog psicología ${category.toLowerCase()}, psicóloga córdoba, ${category.toLowerCase()}, terapia online`;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Artículos sobre ${category}`,
  description,
  url: canonicalUrl,
  numberOfItems: posts.length,
  itemListElement: posts.map((post, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `${SITE_URL}/blog/${post.slug}/`,
    name: post.title,
  })),
};

const breadcrumbData = [
  { name: 'Inicio', url: `${SITE_URL}/` },
  { name: 'Blog', url: `${SITE_URL}/blog/` },
  { name: category, url: canonicalUrl },
];
---

<Layout {title} {description} {keywords} canonical={canonicalPath}>
  <Schema slot="schema" type="breadcrumbs" data={breadcrumbData} />
  <Schema
    slot="schema"
    type="webpage"
    data={{ name: title, description, url: canonicalUrl }}
  />
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <Header activePage="Blog" />

  <main id="main-content">
    <section class="section bg-alabaster relative overflow-hidden" aria-labelledby="category-heading">
      <div class="bg-aurora"></div>

      <div class="container-editorial relative z-10">
        <PageHeader
          label="Blog"
          title={category}
          description={categorySeo.intro}
        >
          <div class="flex flex-wrap gap-3 mt-12">
            <a
              href="/blog/"
              class="px-4 py-2 bg-cream border border-border-delicate text-label-sm text-ink hover:border-olive hover:text-olive transition-colors"
            >
              Todos los artículos
            </a>
            {getBlogCategories()
              .filter((item) => item !== category)
              .map((item) => (
                <a
                  href={getCategoryUrl(item)}
                  class="px-4 py-2 bg-alabaster border border-border-delicate text-label-sm text-charcoal hover:border-olive hover:text-olive transition-colors"
                >
                  {item}
                </a>
              ))}
          </div>
        </PageHeader>
      </div>
    </section>

    <section class="section bg-cream relative" aria-label={`Artículos sobre ${category}`}>
      <div class="container-editorial">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12 border-b border-border-strong pb-8">
          <div>
            <span class="label-section mb-4 block">{posts.length} {posts.length === 1 ? 'artículo' : 'artículos'}</span>
            <p class="text-body-sm text-charcoal max-w-xl">
              Contenido escrito por María Ángeles Mata desde la consulta de psicología en Córdoba, con enfoque clínico y lenguaje claro.
            </p>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
          {posts.map((post, index) => (
            <article
              class="blog-category-card group"
              data-reveal
              data-reveal-delay={index * 80}
            >
              <a href={`/blog/${post.slug}/`} class="block">
                <div class="blog-category-card__image mb-6">
                  <Image
                    src={post.image}
                    alt={post.title}
                    class="w-full h-full object-cover"
                    width={640}
                    loading={index < 2 ? 'eager' : 'lazy'}
                    quality={90}
                  />
                  <div class="absolute inset-0 bg-ink/0 group-hover:bg-ink/10 transition-colors duration-500"></div>
                </div>

                <div class="flex items-center gap-3 mb-3">
                  <span class="text-label-sm text-olive">{post.category}</span>
                  <span class="w-1 h-1 rounded-full bg-taupe"></span>
                  <span class="text-label-sm text-charcoal">{post.date}</span>
                  <span class="w-1 h-1 rounded-full bg-taupe"></span>
                  <span class="text-label-sm text-charcoal">{post.readTime}</span>
                </div>

                <h2
                  id={index === 0 ? 'category-heading' : undefined}
                  class="font-serif text-xl sm:text-2xl text-ink group-hover:text-olive transition-colors duration-500 leading-tight mb-3"
                >
                  {post.title}
                </h2>

                <p class="text-body-sm text-charcoal line-clamp-3 mb-5 leading-relaxed">
                  {post.excerpt}
                </p>

                <span class="inline-flex items-center gap-2 text-label text-ink group-hover:text-olive transition-colors">
                  Leer artículo
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.75L21 12m0 0l-3.75 3.25M21 12H3" />
                  </svg>
                </span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-sm bg-alabaster border-t border-border-delicate">
      <div class="container-editorial text-center">
        <a href="/blog/" class="group inline-flex items-center gap-4 text-ink hover:text-olive transition-colors duration-300">
          <span class="w-10 h-10 rounded-full border border-current flex items-center justify-center group-hover:bg-olive group-hover:border-olive group-hover:text-alabaster transition-all duration-300">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
          </span>
          <span class="font-serif text-xl">Ver todos los artículos del blog</span>
        </a>
      </div>
    </section>

    <CTASection
      label="¿Alguno de estos temas te resuena?"
      title="Podemos hablar"
      highlight="con calma"
      description="Si lo que lees aquí encaja con lo que te ocurre, una primera conversación puede ayudarte a ver si la terapia —presencial en Córdoba u online— es el siguiente paso adecuado."
      primaryAction={{ text: 'Pedir información', href: '/contacto/' }}
      secondaryAction={{ text: '697 733 060', href: 'tel:+34697733060', icon: 'phone' }}
      variant="light"
      centered={true}
    />
  </main>

  <Footer />
</Layout>
