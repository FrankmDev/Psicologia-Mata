---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import TherapyProcess from '../components/TherapyProcess.astro';
import CTASection from '../components/CTASection.astro';
import Schema from '../components/Schema.astro';
import { allServices, servicePricing } from '../data/services';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import terapiaIndividual from '../assets/terapia-individual.avif';
import terapiaPareja from '../assets/terapia-pareja.avif';
import terapiaFamilia from '../assets/terapia-familiar.avif';
import evaluacion from '../assets/evaluacion.avif';
import cognitiva from '../assets/estimulacion-cognitiva.avif';
import { SITE_URL } from '../config/site';
import { serviceOffers } from '../data/business';

const title = 'Servicios y tarifas de psicología en Córdoba | Mata Cala';
const description =
  'Terapia individual y estimulación cognitiva a domicilio en Córdoba, además de atención presencial y online. Apoyo a personas mayores y cuidadores.';
const keywords =
  'terapia individual córdoba, terapia de pareja córdoba, terapia familiar córdoba, evaluación neuropsicológica córdoba, estimulación cognitiva mayores, psicólogo online';

const serviceImages: Record<string, ImageMetadata> = {
  individual: terapiaIndividual,
  pareja: terapiaPareja,
  familiar: terapiaFamilia,
  evaluacion: evaluacion,
  cognitiva: cognitiva,
};

const serviceAlts: Record<string, string> = {
  individual: 'Sesión de terapia individual en Córdoba',
  pareja: 'Sesión de terapia de pareja en Córdoba',
  familiar: 'Sesión de terapia familiar en Córdoba',
  evaluacion: 'Evaluación neuropsicológica en consulta',
  cognitiva: 'Estimulación cognitiva con personas mayores',
};

const serviceDetailUrls: Record<string, string> = {
  individual: '/servicios/terapia-individual/',
  pareja: '/servicios/terapia-pareja-cordoba/',
  evaluacion: '/servicios/evaluacion-neuropsicologica/',
  cognitiva: '/servicios/estimulacion-cognitiva/',
};

const additionalServices = [
  {
    title: 'Terapia para la ansiedad en Córdoba',
    description: 'Atención individual para comprender el malestar y valorar qué apoyo puede encajar.',
    href: '/servicios/ansiedad-cordoba/',
    image: terapiaIndividual,
    imageAlt: 'Espacio de terapia individual, imagen ilustrativa',
  },
  {
    title: 'Psicología para personas mayores',
    description: 'Atención a personas mayores y apoyo psicológico a quienes las cuidan, con opciones de terapia individual, evaluación y estimulación cognitiva.',
    href: '/servicios/psicologia-personas-mayores/',
    image: cognitiva,
    imageAlt: 'Material para una actividad cognitiva, imagen ilustrativa',
  },
];

const serviceContent: Record<string, {
  subtitle: string;
  quote: string;
  approach: string[];
}> = {
  individual: {
    subtitle: 'Ansiedad, autoestima y cambios',
    quote: 'Puede ser ansiedad que no baja, autocrítica constante o una etapa que te supera. La terapia individual puede realizarse en consulta, online o a domicilio en Córdoba; acordamos objetivos y herramientas según tu situación.',
    approach: ['TCC', 'ACT y mindfulness', 'Objetivos revisables']
  },
  pareja: {
    subtitle: 'Comunicación y conflictos',
    quote: 'No se trata de decidir quién tiene razón, sino de entender el patrón que os atrapa: qué se repite, qué os aleja y cómo cambiar la conversación para que no os desgaste.',
    approach: ['Pautas de comunicación', 'Gestión de conflictos', 'Acuerdos concretos']
  },
  familiar: {
    subtitle: 'Roles, límites y convivencia',
    quote: 'Cuando un conflicto se repite, toda la familia lo nota. Trabajamos qué mantiene el problema y cómo cambiar la forma de relacionarse, sin buscar un único culpable.',
    approach: ['Perspectiva sistémica', 'Límites y acuerdos', 'Pautas para casa']
  },
  evaluacion: {
    subtitle: 'Memoria, atención y concentración',
    quote: 'Si notas cambios en memoria, atención o concentración, una evaluación permite describir qué ocurre y orientar los siguientes pasos. No sustituye una valoración médica.',
    approach: ['Entrevista y pruebas', 'Informe acordado', 'Orientación']
  },
  cognitiva: {
    subtitle: 'Mayores y autonomía',
    quote: 'Actividades ajustadas a los intereses y el ritmo de cada persona para trabajar memoria, atención y orientación.',
    approach: ['Online o domicilio', 'Materiales adaptados', 'Seguimiento']
  }
};

const faqs = [
  {
    question: '¿Cuánto dura una sesión?',
    answer: 'Depende del tipo de terapia. Las sesiones individuales duran 50 minutos, las de pareja 60 minutos y las familiares 75 minutos. En la primera sesión definimos el motivo de consulta y los objetivos.'
  },
  {
    question: '¿Tengo que venir cada semana?',
    answer: 'La frecuencia se acuerda según el motivo de consulta, los objetivos y tus circunstancias. Puede revisarse a lo largo del proceso para que el ritmo tenga sentido para ti.'
  },
  {
    question: '¿Cómo sé qué tipo de terapia necesito?',
    answer: 'No hace falta saberlo de antemano. En la primera consulta revisamos tu situación y valoramos qué enfoque tiene sentido. Si el formato o el enfoque no encajan, te lo diré con claridad.'
  },
  {
    question: '¿Qué técnicas usas?',
    answer: 'Trabajo principalmente con Terapia Cognitivo-Conductual (TCC) y terapias de tercera generación como ACT y mindfulness. Selecciono los procedimientos según la valoración, los objetivos acordados y las necesidades de cada persona.'
  },
  {
    question: '¿Qué servicios se realizan a domicilio en Córdoba?',
    answer: 'La terapia individual y la estimulación cognitiva pueden realizarse a domicilio en Córdoba. La zona, la disponibilidad y cualquier posible coste de desplazamiento se confirman al contactar.'
  },
  {
    question: '¿Ofreces apoyo psicológico a cuidadores?',
    answer: 'Sí. Puedes consultar por orientación y apoyo psicológico ante las dificultades asociadas al cuidado de una persona mayor. El formato se valora según cada situación.'
  }
];

const SITE = SITE_URL;

// Schema data
const breadcrumbData = [
  { name: "Inicio", url: `${SITE}/` },
  { name: "Servicios", url: `${SITE}/servicios/` }
];

const faqSchemaData = faqs.map(faq => ({
  question: faq.question,
  answer: faq.answer
}));
---

<Layout {title} {description} {keywords} canonical="/servicios/">
  <Schema slot="schema" type="breadcrumbs" data={breadcrumbData} />
  <Schema slot="schema" type="webpage" data={{ name: title, description, url: `${SITE}/servicios/` }} />
  <Schema slot="schema" type="faqpage" data={faqSchemaData} />
  <Schema slot="schema" type="servicecatalog" data={serviceOffers} />
  <Header activePage="Servicios" />
  
  <main id="main-content">
    
    <!-- Hero -->
    <section class="section bg-alabaster relative overflow-hidden" aria-labelledby="services-heading">
      <div class="bg-aurora"></div>
      
      <div class="container-editorial relative z-10">
        <PageHeader
          id="services-heading"
          label="Servicios"
          title="Psicología en Córdoba,"
          highlight="presencial y online"
          description="Terapia individual, de pareja y familiar, evaluación neuropsicológica y estimulación cognitiva. La terapia individual y la estimulación pueden realizarse a domicilio en Córdoba. Atención a personas mayores y cuidadores."
        >
          <!-- Navegación tipo índice -->
          <div class="flex flex-wrap gap-x-8 gap-y-4 mt-16">
            {allServices.map((service) => (
              <a 
                href={`#${service.id}`}
                class="group flex items-baseline gap-3 text-ink hover:text-olive transition-colors duration-300"
              >
                <span class="text-label text-olive" aria-hidden="true">{service.number}</span>
                <span class="font-serif text-lg">{service.title}</span>
              </a>
            ))}
            {additionalServices.map((service) => (
              <a href={service.href} class="group flex items-baseline gap-3 text-ink hover:text-olive transition-colors duration-300">
                <span class="text-label text-olive/50 group-hover:text-olive transition-colors" aria-hidden="true">↗</span>
                <span class="font-serif text-lg">{service.title}</span>
              </a>
            ))}
          </div>
        </PageHeader>
      </div>
    </section>

    <!-- Servicios - Layout Editorial Asimétrico -->
    {allServices.map((service, index) => {
      const content = serviceContent[service.id];
      const isEven = index % 2 === 1;
      
      return (
        <section 
          id={service.id}
          class={`section ${isEven ? "bg-cream" : "bg-alabaster"} relative overflow-hidden scroll-mt-24 lg:scroll-mt-28`}
          aria-labelledby={`service-${service.id}-heading`}
        >
          {/* Número decorativo de fondo */}
          <span aria-hidden="true" class={`absolute ${isEven ? '-right-20' : '-left-20'} top-1/2 -translate-y-1/2 font-serif text-[20rem] text-olive/[0.02] leading-none select-none pointer-events-none hidden lg:block`}>
            {service.number}
          </span>
          
          <div class="container-editorial relative z-10">
            <div class="grid lg:grid-cols-12 gap-8 lg:gap-16 items-center">
              
              {/* Imagen */}
              <div class={`lg:col-span-5 ${isEven ? 'lg:col-start-8' : 'lg:col-start-1'}`} data-reveal={isEven ? "left" : "right"}>
                <div class="relative group">
                  <div class={`absolute -inset-4 border border-olive/20 transition-transform duration-700 ease-out ${isEven ? 'group-hover:translate-x-3' : 'group-hover:-translate-x-3'}`}></div>
                  
                  <div class={`relative img-reveal-wrapper aspect-[3/4] overflow-hidden transition-transform duration-700 ease-out ${isEven ? 'group-hover:translate-x-3' : 'group-hover:-translate-x-3'}`}>
                    <Image 
                      src={serviceImages[service.id]} 
                      alt={serviceAlts[service.id]}
                      class="absolute inset-0 w-full h-full object-cover filter grayscale-[20%] sepia-[5%] group-hover:grayscale-0 group-hover:sepia-0 transition-all duration-700 group-hover:scale-105"
                      width={600}
                      densities={[1.5, 2]}
                      format="webp"
                      quality={85}
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-ink/30 via-ink/5 to-transparent opacity-60 group-hover:opacity-40 transition-opacity duration-500"></div>
                    <span aria-hidden="true" class="absolute top-6 left-6 text-label text-alabaster/90 mix-blend-difference">
                      {service.number}
                    </span>
                  </div>
                </div>
              </div>
              
              {/* Contenido */}
              <div class={`lg:col-span-6 ${isEven ? 'lg:col-start-1 lg:row-start-1' : 'lg:col-start-7'} lg:py-12`} data-reveal data-reveal-delay="100">
                <div class="mb-10">
                  <div class="flex items-baseline gap-4 mb-6">
                    <span class="text-label text-olive">{service.number}</span>
                    <div class="flex-1 h-[1px] bg-border-delicate origin-left scale-x-0 animate-[scale-x_1s_ease-out_forwards]" style="animation-delay: 0.3s;"></div>
                  </div>
                  
                  <p class="text-label-sm text-olive mb-3">{content.subtitle}</p>
                  <h2 id={`service-${service.id}-heading`} class="title-section">
                    {service.title}
                  </h2>
                </div>
                
                <blockquote class="relative mb-10 pt-6">
                  <span class="absolute top-0 left-0 font-serif text-5xl text-olive/20 leading-none">"</span>
                  <p class="text-body text-charcoal leading-relaxed pl-6 pt-4 border-l-2 border-olive/30">
                    {content.quote}
                  </p>
                </blockquote>
                
                <div class="flex flex-wrap gap-3 mb-10">
                  {content.approach.map((item) => (
                    <span class="px-4 py-2 bg-cream border border-border-delicate text-label-xs text-ink">
                      {item}
                    </span>
                  ))}
                </div>
                
                <div class="flex flex-wrap items-center gap-4 sm:gap-6">
                  <a href={serviceDetailUrls[service.id] ?? '/contacto/'} class="btn btn-sage group">
                    <span>{serviceDetailUrls[service.id] ? 'Ver servicio y proceso' : 'Consultar el servicio'}</span>
                    <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.75L21 12m0 0l-3.75 3.25M21 12H3" />
                    </svg>
                  </a>
                  <span class="text-label-xs text-ink">{service.duration}</span>
                </div>
              </div>
            </div>
          </div>
        </section>
      );
    })}

    <section class="section bg-cream" aria-labelledby="additional-services-heading">
      <div class="container-editorial">
        <div class="max-w-3xl mb-12" data-reveal>
          <span class="label-section">Atención específica</span>
          <h2 id="additional-services-heading" class="title-section mt-8">Encuentra la información de cada <em class="text-olive italic">servicio</em></h2>
        </div>
        <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
          {additionalServices.map((service, index) => (
            <a href={service.href} class="group grid sm:grid-cols-5 gap-6 items-center border-t border-border-delicate pt-6" data-reveal data-reveal-delay={index * 100}>
              <Image src={service.image} alt={service.imageAlt} class="sm:col-span-2 aspect-[4/3] w-full object-cover" width={500} format="webp" quality={85} loading="lazy" />
              <div class="sm:col-span-3">
                <h3 class="font-serif text-2xl text-ink group-hover:text-olive transition-colors">{service.title}</h3>
                <p class="text-body-sm mt-3">{service.description}</p>
                <span class="inline-block mt-5 text-label text-olive underline underline-offset-4">Ver información del servicio</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Tarifas -->
    <section class="section bg-alabaster relative overflow-hidden scroll-mt-24 lg:scroll-mt-28" id="tarifas" aria-labelledby="tarifas-heading">

      <!-- Número decorativo de fondo -->
      <span class="absolute -right-8 top-1/2 -translate-y-1/2 font-serif text-[22rem] leading-none text-olive/[0.025] select-none pointer-events-none hidden lg:block" aria-hidden="true">€</span>

      <div class="container-editorial relative z-10">
        <div class="grid lg:grid-cols-12 gap-y-12 lg:gap-x-6 xl:gap-x-8 items-start">

          <!-- Columna izquierda: encabezado editorial -->
          <div class="lg:col-span-4 lg:sticky lg:top-32" data-reveal>

            <span class="label-section">Tarifas</span>

            <h2 id="tarifas-heading" class="title-section mt-8">
              Cuánto<br />cuesta<br /><em class="text-olive italic">la terapia</em>
            </h2>

            <p class="text-body-sm text-charcoal mt-8 leading-relaxed">
              Estos son los precios por sesión. En la primera consulta se aborda el motivo y se explican el encuadre y los siguientes pasos.
            </p>
            <p class="text-body-sm mt-4">Antes de reservar, confirma el coste de la primera cita, las condiciones de cancelación y, si es a domicilio, cualquier coste de desplazamiento.</p>
            <a href="/contacto/" class="btn btn-outline mt-8">Consultar disponibilidad</a>
          </div>

          <div class="lg:col-span-7 lg:col-start-6 min-w-0">
            <div class="space-y-4">
              {servicePricing.map((item, index) => (
                <div
                  class="group border-b border-ink/10 hover:border-olive/30 transition-colors duration-500 cursor-default"
                  data-reveal
                  data-reveal-delay={index * 80}
                >
                  <div class="py-8 lg:py-10 flex flex-wrap items-center gap-4 sm:gap-8 lg:gap-10">

                    <!-- Número -->
                    <span aria-hidden="true" class="font-sans text-xs font-medium tracking-widest text-olive group-hover:text-olive-dark transition-colors duration-500 shrink-0 hidden sm:block">
                      {item.number}
                    </span>

                    <!-- Contenido central -->
                    <div class="flex-1 min-w-[10rem]">
                      <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4 mb-2">
                        <h3 class="font-serif text-xl lg:text-2xl text-ink group-hover:text-olive transition-colors duration-500 leading-tight">
                          {item.title}
                        </h3>
                        <div class="flex items-center gap-2 flex-wrap">
                          {item.tags.map((tag) => (
                            <span class="inline-flex items-center px-2.5 py-0.5 text-[0.6rem] font-medium tracking-widest uppercase border border-border-strong text-charcoal/70 group-hover:border-olive/40 group-hover:text-olive transition-colors duration-500">
                              {tag}
                            </span>
                          ))}
                        </div>
                      </div>
                      <p class="text-body-sm text-charcoal/75 group-hover:text-charcoal transition-colors duration-500 leading-relaxed">
                        {item.description}
                      </p>
                    </div>

                    <!-- Precio -->
                    <div class="shrink-0 text-right">
                      <div class="flex items-baseline justify-end gap-0.5">
                        <span class="font-serif text-4xl lg:text-5xl text-ink group-hover:text-olive transition-colors duration-700 leading-none tabular-nums">
                          {item.priceLabel}
                        </span>
                        {item.price !== undefined && (
                          <span class="font-serif text-xl lg:text-2xl text-ink/70 group-hover:text-olive transition-colors duration-700 leading-none">
                            €
                          </span>
                        )}
                      </div>
                      {item.price === undefined && <p class="text-body-sm mb-1">Precio a consultar</p>}
                      <p class="text-label-xs text-charcoal/75 mt-1.5 group-hover:text-olive transition-colors duration-500">
                        {item.billingDuration}
                      </p>
                    </div>

                  </div>
                  <!-- Línea expansiva en hover (mismo patrón que sección servicios) -->
                  <div class="w-0 h-[1px] bg-olive/40 group-hover:w-full transition-all duration-700 ease-out -mt-px"></div>
                </div>
              ))}
            </div>

            <!-- Nota mutuas -->
            <div class="mt-10 flex items-start gap-4 p-6 border border-border-delicate bg-cream/50" data-reveal data-reveal-delay="400">
              <svg class="w-4 h-4 text-olive/60 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
              </svg>
              <p class="text-body-sm text-charcoal/70 leading-relaxed">
                Consulta privada, sin convenio con la Seguridad Social. Si tienes una mutua o seguro privado,
                consulta con la compañía si tu póliza cubre o reembolsa sesiones de psicología y qué documentación requiere.
              </p>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- Proceso Terapéutico -->
    <TherapyProcess variant="dark" />

    <!-- FAQ -->
    <section class="section bg-cream relative">
      <div class="container-editorial">
        
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-12 mb-16 lg:mb-24">
          <div data-reveal class="max-w-2xl">
            <div class="mb-8">
              <span class="label-section">Preguntas frecuentes</span>
            </div>
            <h2 class="title-section">
              Antes de <em class="text-olive italic">empezar</em>
            </h2>
          </div>
          <div class="flex items-end lg:justify-end" data-reveal data-reveal-delay="100">
            <p class="text-body-sm max-w-sm lg:text-right border-t border-olive/40 pt-5">
              Si no encuentras tu respuesta, escríbeme y te contesto personalmente.
            </p>
          </div>
        </div>

        <div class="max-w-4xl mx-auto border-t border-ink/20">
          {faqs.map((faq, index) => (
            <div data-reveal data-reveal-delay={index * 100}>
              <details class="group border-b border-ink/20 open:border-olive/50 transition-colors duration-500">
                <summary class="flex cursor-pointer items-center justify-between gap-8 py-8 lg:py-10 select-none list-none">
                  <h3 class="flex items-center gap-6 md:gap-12 min-w-0 flex-1">
                    <span class="text-label text-olive font-semibold w-8 md:w-12 shrink-0" aria-hidden="true">
                      0{index + 1}
                    </span>
                    <span class="font-serif text-lg sm:text-xl lg:text-2xl text-ink group-hover:text-olive transition-colors duration-300 pr-4 leading-[1.2]">
                      {faq.question}
                    </span>
                  </h3>
                  
                  <span aria-hidden="true" class="shrink-0 w-10 h-10 rounded-full border border-ink/20 flex items-center justify-center group-hover:bg-ink group-hover:border-ink text-ink group-hover:!text-alabaster transition-all duration-500 group-open:rotate-[135deg]">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                  </span>
                </summary>
                
                <div class="pb-10 pl-[4.5rem] md:pl-24 text-body-sm sm:text-body text-charcoal max-w-3xl">
                  {faq.answer}
                </div>
              </details>
            </div>
          ))}
        </div>

        <div class="mt-24 pt-12 border-t border-border-delicate flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left" data-reveal data-reveal-delay="300">
          <div>
            <p class="text-label-sm text-charcoal mb-2">¿Te queda alguna duda?</p>
            <p class="font-serif text-lg sm:text-xl text-ink">Escríbeme directamente</p>
          </div>
          <a href="/contacto/" class="btn btn-outline">
            Consultar mi caso
          </a>
        </div>
        
      </div>
    </section>

    <!-- CTA Final -->
    <CTASection
      label="El primer paso"
      title="¿Te gustaría que"
      highlight="habláramos?"
      description="En la primera sesión hablamos de lo que te ocurre, te explico cómo trabajo y valoramos juntos si la terapia puede ayudarte."
      primaryAction={{ text: "Solicitar cita", href: "/contacto/", icon: true }}
      secondaryAction={{ text: "Llamar", href: "tel:+34697733060", icon: "phone" }}
    />

  </main>
  
  <Footer />
</Layout>
