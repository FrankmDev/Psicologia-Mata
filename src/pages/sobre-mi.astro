---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import CTASection from '../components/CTASection.astro';
import Schema from '../components/Schema.astro';
import { Image } from 'astro:assets';
import mariaAngelesMata from '../assets/maria-angeles-mata.jpeg';
import { aboutCredentials, personData } from '../data/business';
import { SITE_URL } from '../config/site';

const title = 'Sobre mí | Psicóloga sanitaria en Córdoba | María Ángeles Mata';
const description =
  'Conoce a María Ángeles Mata en Córdoba. Atención a personas mayores y cuidadores; terapia individual y estimulación cognitiva a domicilio.';
const keywords =
  'maría ángeles mata, psicóloga córdoba, psicóloga general sanitaria, colegiada AN 12177, neuropsicología córdoba, gerontología';

const SITE = SITE_URL;

const breadcrumbData = [
  { name: 'Inicio', url: `${SITE}/` },
  { name: 'Sobre mí', url: `${SITE}/sobre-mi/` },
];
---

<Layout {title} {description} {keywords} canonical="/sobre-mi/">
  <Schema slot="schema" type="person" data={personData} />
  <Schema slot="schema" type="breadcrumbs" data={breadcrumbData} />
  <Schema
    slot="schema"
    type="webpage"
    data={{ name: title, description, url: `${SITE}/sobre-mi/` }}
  />
  <Header activePage="Sobre mí" />

  <main id="main-content">
    <section class="section bg-alabaster relative overflow-hidden" aria-labelledby="about-page-heading">
      <div class="bg-aurora"></div>

      <div class="container-editorial relative z-10">
        <PageHeader
          id="about-page-heading"
          label="Sobre mí"
          title="María Ángeles Mata,"
          highlight="psicóloga en Córdoba"
          description="Psicóloga general sanitaria colegiada AN 12177. Terapia individual, de pareja y familiar, evaluación neuropsicológica y estimulación cognitiva, presencial en Córdoba y online."
        />
      </div>
    </section>

    <section class="section bg-alabaster relative">
      <div class="container-editorial">
        <div class="max-w-4xl mx-auto text-center mb-20 lg:mb-32">
          <h2 id="about-heading" class="title-section">
            "Un espacio para entender lo que te ocurre y trabajar objetivos concretos, con rigor profesional y sin tener que aparentar que todo va bien."
          </h2>
        </div>

        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-stretch">
          <div class="relative h-full" data-reveal="left">
            <div class="relative w-full max-w-md mx-auto h-full flex flex-col">
              <div class="absolute -inset-4 bg-stone/20 rounded-[40px] hidden md:block rotate-[-3deg] z-0"></div>

              <div class="img-reveal-wrapper flex-1 rounded-[30px] overflow-hidden z-10 relative shadow-2xl shadow-ink/5">
                <Image
                  src={mariaAngelesMata}
                  alt="María Ángeles Mata - Psicóloga en Córdoba"
                  width={500}
                  densities={[1.5, 2]}
                  sizes="(min-width: 1024px) 448px, 82vw"
                  loading="lazy"
                  quality={85}
                  format="webp"
                  class="w-full h-full object-cover filter grayscale-[20%] sepia-[15%] brightness-105"
                  style="min-height: 100%; aspect-ratio: 3/4;"
                />
              </div>
            </div>
          </div>

          <div class="flex flex-col justify-between" data-reveal="right">
            <div>
              <div class="space-y-6 mb-12">
                <p class="text-body-sm">
                  Soy María Ángeles Mata Cala, psicóloga general sanitaria (AN 12177). Trabajo con adultos, parejas y familias ante ansiedad, conflictos o cambios vitales.
                </p>
                <p class="text-body-sm">
                  Mi formación en neuropsicología, deterioro cognitivo y gerontología sostiene un foco especial en el bienestar de las personas mayores y de quienes las cuidan. Ofrezco terapia individual y estimulación cognitiva también a domicilio en Córdoba, además de evaluación cuando está indicada.
                </p>
              </div>

              <div class="mb-12">
                <div class="flex items-center gap-4 mb-6">
                  <span class="text-label-sm text-charcoal">Formación y titulaciones</span>
                  <span class="h-[1px] flex-1 bg-border-delicate"></span>
                </div>

                <div class="space-y-3">
                  {aboutCredentials.map((cred) => (
                    <div class="flex items-baseline gap-4">
                      <span class="text-label-xs text-olive w-10 shrink-0">{cred.year}</span>
                      <span class="text-xs sm:text-sm text-ink leading-relaxed">
                        {cred.title}
                        <span class="text-charcoal"> — {cred.institution}</span>
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <div>
              <a href="/contacto/" class="btn btn-sage">Solicitar una cita</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTASection
      label="¿Hablamos?"
      title="El primer paso es solo"
      highlight="una conversación"
      description="Cuéntame qué te ocurre y te explicaré cómo trabajo, la duración y el coste para que conozcas el encuadre desde el inicio."
      primaryAction={{ text: 'Solicitar cita', href: '/contacto/', icon: true }}
      variant="dark"
    />
  </main>

  <Footer />
</Layout>
