---
/**
 * RevealAnimation - Componente de animaciones de scroll
 * Mejora progresiva con IntersectionObserver; nunca oculta el contenido inicial.
 * No requiere hidratación - el script se ejecuta en el cliente directamente
 */
---

<script>
  (function initRevealAnimations() {
    'use strict';

    let observer: IntersectionObserver | null = null;

    function init() {
      if (typeof window === 'undefined' || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (!('IntersectionObserver' in window)) return;

      const elements = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      const pending = elements.filter((element) => !element.classList.contains('is-visible'));
      if (!pending.length) return;

      observer?.disconnect();
      observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const target = entry.target as HTMLElement;
          const delay = Number.parseInt(target.dataset.revealDelay || '0', 10) || 0;
          target.style.setProperty('--reveal-delay', `${Math.min(200, Math.max(0, delay))}ms`);
          target.classList.add('is-visible');
          observer?.unobserve(target);
        });
      }, { threshold: 0.1, rootMargin: '50px 0px 0px 0px' });

      pending.forEach((element) => observer?.observe(element));
    }

    function cleanup() {
      observer?.disconnect();
      observer = null;
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      requestAnimationFrame(init);
    }

    document.addEventListener('astro:page-load', () => requestAnimationFrame(init));
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  })();
</script>
