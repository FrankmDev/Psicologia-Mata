---
// JSON-LD para entidades y contenidos que aparecen realmente en cada página.

interface LocalBusinessData {
  name: string;
  legalName?: string;
  description: string;
  url: string;
  telephone: string;
  email?: string;
  address: {
    streetAddress: string;
    addressLocality: string;
    postalCode: string;
    addressCountry: string;
  };
  image?: string;
  openingHours?: string[];
  serviceArea?: string;
  socialProfiles?: string[];
  foundingDate?: string;
  founderName?: string;
}

interface ArticleData {
  headline: string;
  description: string;
  image: string;
  datePublished: string;
  dateModified?: string;
  author: {
    name: string;
    url?: string;
  };
  publisher?: {
    name: string;
    logo?: string;
  };
  url: string;
  articleSection?: string;
  keywords?: string[];
  wordCount?: number;
}

interface WebPageData {
  name: string;
  description: string;
  url: string;
  image?: string;
}

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface FAQItem {
  question: string;
  answer: string;
}

interface PersonData {
  name: string;
  url: string;
  jobTitle?: string;
  description?: string;
  telephone?: string;
  email?: string;
  image?: string;
  sameAs?: string[];
  address?: {
    streetAddress: string;
    addressLocality: string;
    postalCode: string;
    addressCountry: string;
  };
  knowsAbout?: string[];
  credentials?: {
    name: string;
    year?: string;
    institution?: string;
    type?: string;
  }[];
  licenseNumber?: string;
  licenseOrganization?: string;
}

interface ServiceOfferItem {
  name: string;
  description: string;
  price?: string;
  priceCurrency?: string;
  duration: string;
  url: string;
}

interface Props {
  type:
    | 'localbusiness'
    | 'article'
    | 'webpage'
    | 'breadcrumbs'
    | 'faqpage'
    | 'person'
    | 'servicecatalog';
  data:
    | LocalBusinessData
    | ArticleData
    | WebPageData
    | BreadcrumbItem[]
    | FAQItem[]
    | PersonData
    | ServiceOfferItem[];
}

import { SITE_URL } from '../config/site';

const { type, data } = Astro.props;

function generateLocalBusinessSchema(data: LocalBusinessData) {
  const businessUrl = data.url.replace(/\/$/, '');
  const businessId = `${businessUrl}/#business`;
  const schema: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': businessId,
    name: data.name,
    ...(data.legalName && { legalName: data.legalName }),
    description: data.description,
    url: data.url,
    telephone: data.telephone,
    ...(data.email && { email: data.email }),
    inLanguage: 'es-ES',
    address: {
      '@type': 'PostalAddress',
      ...data.address,
    },
    ...(data.image && { image: data.image }),
    ...(data.openingHours?.length && { openingHours: data.openingHours }),
    ...(data.socialProfiles?.length && { sameAs: data.socialProfiles }),
    ...(data.serviceArea && { areaServed: data.serviceArea }),
    ...(data.foundingDate && { foundingDate: data.foundingDate }),
    ...(data.founderName && {
      founder: {
        '@type': 'Person',
        name: data.founderName,
        '@id': `${businessUrl}/sobre-mi/#person`,
      },
    }),
  };

  return schema;
}

function generateArticleSchema(data: ArticleData) {
  const articleImage = data.image.startsWith('http') ? data.image : `${SITE_URL}${data.image}`;

  return {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.headline,
    description: data.description,
    image: articleImage,
    datePublished: data.datePublished,
    dateModified: data.dateModified || data.datePublished,
    inLanguage: 'es-ES',
    ...(data.articleSection ? { articleSection: data.articleSection } : {}),
    ...(data.keywords?.length ? { keywords: data.keywords.join(', ') } : {}),
    ...(data.wordCount ? { wordCount: data.wordCount } : {}),
    author: {
      '@type': 'Person',
      name: data.author.name,
      ...(data.author.url ? { url: data.author.url } : {}),
    },
    publisher: {
      '@type': 'Person',
      '@id': `${SITE_URL}/sobre-mi/#person`,
      name: data.publisher?.name || 'María Ángeles Mata Cala',
      url: `${SITE_URL}/sobre-mi/`,
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': data.url,
    },
    isPartOf: {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: 'María Ángeles Mata | Psicóloga en Córdoba y online',
      url: SITE_URL,
    },
  };
}

function generateWebPageSchema(data: WebPageData) {
  return {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: data.name,
    description: data.description,
    url: data.url,
    ...(data.image ? { image: data.image } : {}),
    inLanguage: 'es-ES',
    isPartOf: {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: 'María Ángeles Mata | Psicóloga en Córdoba y online',
      url: SITE_URL,
    },
  };
}

function generateBreadcrumbSchema(items: BreadcrumbItem[]) {
  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: item.url,
    })),
  };
}

function generateFAQSchema(items: FAQItem[]) {
  return {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  };
}

function generatePersonSchema(data: PersonData) {
  const personUrl = data.url.replace(/\/$/, '');
  const schema: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${personUrl}/#person`,
    name: data.name,
    url: data.url,
    ...(data.jobTitle && { jobTitle: data.jobTitle }),
    ...(data.description && { description: data.description }),
    ...(data.telephone && { telephone: data.telephone }),
    ...(data.email && { email: data.email }),
    ...(data.image && { image: data.image }),
    inLanguage: 'es-ES',
    ...(data.sameAs?.length && { sameAs: data.sameAs }),
    worksFor: {
      '@type': 'ProfessionalService',
      '@id': `${SITE_URL}/#business`,
    },
  };

  if (data.address) {
    schema.address = {
      '@type': 'PostalAddress',
      ...data.address,
    };
  }

  if (data.knowsAbout?.length) {
    schema.knowsAbout = data.knowsAbout;
  }

  if (data.credentials?.length) {
    schema.hasCredential = data.credentials.map((credential) => ({
      '@type': 'EducationalOccupationalCredential',
      name: credential.name,
      ...(credential.year && { dateCreated: credential.year }),
      ...(credential.type && { credentialCategory: credential.type }),
      ...(credential.institution && {
        recognizedBy: {
          '@type': 'Organization',
          name: credential.institution,
        },
      }),
    }));
  }

  if (data.licenseNumber) {
    schema.identifier = {
      '@type': 'PropertyValue',
      name: 'Número de colegiada',
      value: data.licenseNumber,
      ...(data.licenseOrganization && { propertyID: data.licenseOrganization }),
    };
  }

  return schema;
}

function generateServiceCatalogSchema(offers: ServiceOfferItem[]) {
  return {
    '@context': 'https://schema.org',
    '@type': 'OfferCatalog',
    name: 'Servicios de psicología',
    itemListElement: offers.map((offer, index) => ({
      '@type': 'Offer',
      position: index + 1,
      url: offer.url,
      ...(offer.price
        ? {
            price: offer.price,
            priceCurrency: offer.priceCurrency || 'EUR',
          }
        : {}),
      itemOffered: {
        '@type': 'Service',
        name: offer.name,
        description: offer.description,
        url: offer.url,
      },
    })),
  };
}

let schemaData: Record<string, unknown> | null = null;

switch (type) {
  case 'localbusiness':
    schemaData = generateLocalBusinessSchema(data as LocalBusinessData);
    break;
  case 'article':
    schemaData = generateArticleSchema(data as ArticleData);
    break;
  case 'webpage':
    schemaData = generateWebPageSchema(data as WebPageData);
    break;
  case 'breadcrumbs':
    schemaData = generateBreadcrumbSchema(data as BreadcrumbItem[]);
    break;
  case 'faqpage':
    schemaData = generateFAQSchema(data as FAQItem[]);
    break;
  case 'person':
    schemaData = generatePersonSchema(data as PersonData);
    break;
  case 'servicecatalog':
    schemaData = generateServiceCatalogSchema(data as ServiceOfferItem[]);
    break;
  default: {
    const _exhaustive: never = type;
    schemaData = null;
    void _exhaustive;
  }
}

const schemaJson = schemaData ? JSON.stringify(schemaData) : '';
---

{schemaJson && <script type="application/ld+json" set:html={schemaJson} />}
