const iconSvg = icons[name] || '';
---

<svg 
  class={className}
  fill="none" 
  viewBox="0 0 24 24" 
  stroke="currentColor"
  aria-hidden="true"
>
  <Fragment set:html={iconSvg} />
</svg>
