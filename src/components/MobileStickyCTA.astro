---
import { CONTACT_PHONE_E164, CONTACT_PHONE_DISPLAY } from '../config/site';
---

<div
  class="lg:hidden fixed bottom-0 inset-x-0 z-50 border-t border-border-delicate bg-alabaster/95 backdrop-blur-md"
  aria-label="Acciones de contacto rápido"
>
  <div class="grid grid-cols-2 divide-x divide-border-delicate">
    <a
      href={`tel:${CONTACT_PHONE_E164}`}
      class="flex items-center justify-center gap-2 py-3.5 text-label text-ink hover:text-olive transition-colors"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
      </svg>
      <span>{CONTACT_PHONE_DISPLAY}</span>
    </a>
    <a
      href="/contacto/"
      class="flex items-center justify-center gap-2 py-3.5 text-label text-alabaster bg-olive hover:bg-olive-dark transition-colors"
    >
      <span>Pedir cita</span>
    </a>
  </div>
</div>
